ARG_ENABLE("ucache", "Windows PHP Cache 2", "no");

if (PHP_UCACHE != "no") {
    if (PHP_ZTS != "no") {
        WARNING("UCache module requires --disable-zts build of PHP on windows");
    } else {
        EXTENSION('ucache', "php_ucache.c ucache_utils.c ucache_error.c         \
                               ucache_debug.c ucache_lock.c ucache_filemap.c      \
                               ucache_alloc.c \
                               ucache_fcache.c ucache_rplist.c ucache_aplist.c    \
                               ucache_zvcache.c ucache_session.c                    \
                               ucache_fcnotify.c",
                               true,
                               "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");

        ADD_EXTENSION_DEP('ucache', 'session');
        AC_DEFINE('HAVE_UCACHE', 1);

        DEFINE('UCACHE_ETW_RC', configure_module_dirname + '\\ucache_etw.rc');

        ADD_FLAG('LDFLAGS_UCACHE', '/NXCOMPAT');
        if (!X64) {
            ADD_FLAG('LDFLAGS_UCACHE', '/SAFESEH');
        }

        ADD_FLAG('CFLAGS_UCACHE', '/GS');
        ADD_FLAG('CFLAGS_UCACHE', '/I' + configure_module_dirname + ' ');

        if (PHP_DEBUG == "yes") {
            ADD_FLAG('LDFLAGS_UCACHE', '/debug /debugtype:cv,fixup');
            ADD_FLAG('CFLAGS_UCACHE', '/D UCACHE_DEBUG');
            ADD_FLAG('CFLAGS_UCACHE', '/Zi');
            ADD_FLAG('CFLAGS_UCACHE', '/WX');
        }

        ADD_FLAG('DEPS_UCACHE', configure_module_dirname + '\\ucache_etw.rc');

        CHECK_LIB("Kernel32.lib", "ucache", PHP_UCACHE);
    }
}
